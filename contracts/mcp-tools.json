{
  "contract": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Run every deterministic time-off rule against a request and return one finding per rule.",
      "inputSchema": {
        "properties": {
          "end": {
            "title": "End",
            "type": "string"
          },
          "hours": {
            "title": "Hours",
            "type": "number"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "submitted_at": {
            "title": "Submitted At",
            "type": "string"
          },
          "worker_id": {
            "title": "Worker Id",
            "type": "string"
          }
        },
        "required": [
          "worker_id",
          "plan",
          "start",
          "end",
          "hours",
          "submitted_at"
        ],
        "title": "evaluate_policyArguments",
        "type": "object"
      },
      "name": "evaluate_policy",
      "outputSchema": {
        "$defs": {
          "Finding": {
            "description": "Result of one deterministic policy rule. Never produced by a model.",
            "properties": {
              "detail": {
                "title": "Detail",
                "type": "string"
              },
              "evidence": {
                "additionalProperties": true,
                "title": "Evidence",
                "type": "object"
              },
              "rule_id": {
                "title": "Rule Id",
                "type": "string"
              },
              "rule_name": {
                "title": "Rule Name",
                "type": "string"
              },
              "severity": {
                "enum": [
                  "blocking",
                  "advisory"
                ],
                "title": "Severity",
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "warn"
                ],
                "title": "Status",
                "type": "string"
              }
            },
            "required": [
              "rule_id",
              "rule_name",
              "status",
              "severity",
              "detail"
            ],
            "title": "Finding",
            "type": "object"
          }
        },
        "properties": {
          "findings": {
            "items": {
              "$ref": "#/$defs/Finding"
            },
            "title": "Findings",
            "type": "array"
          }
        },
        "required": [
          "findings"
        ],
        "title": "Findings",
        "type": "object"
      }
    },
    {
