  "cards": [
    {
      "dot": "emerald",
      "title": "Deterministic, not inferred",
      "items": [
        "Policy is evaluated in Python over data/policy.json",
        "The model receives findings it cannot dispute or re-derive",
        "A policy change is a data change, not a prompt change"
      ]
    },
    {
      "dot": "cyan",
      "title": "Where a model actually runs",
      "items": [
        "Two calls only: the assessment and the judge",
        "No retrieval layer \u2014 nothing is embedded, indexed or searched",
        "Both calls are content-addressed against the fixture cache"
      ]
    },
    {
      "dot": "rose",
      "title": "Human authority, and the record of it",
      "items": [
        "approval_gate suspends the graph until a decision is supplied",
        "Decision.actor_type is pinned to human at the type level",
        "The hash chain keeps an override visible: agent said X, human chose Y"
      ]
    }
  ]
