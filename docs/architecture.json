  "cards": [
    {
      "dot": "emerald",
      "title": "Deterministic, not inferred",
      "items": [
        "Policy is evaluated in Python over data/policy.json",
        "The model receives findings it cannot dispute or re-derive",
        "A policy change is a data change, not a prompt change"
      ]
    },
    {
      "dot": "cyan",
      "title": "Where a model actually runs",
      "items": [
        "Two calls in the graph: the assessment and the judge",
        "Retrieval embeds locally; Qdrant filters by tenant first",
        "Calls and embeddings are fixture-backed; live ones are capped"
      ]
    },
    {
      "dot": "rose",
      "title": "Human authority and its record",
      "items": [
        "Only the employee's manager can approve; never themselves",
        "Gate suspends the graph; SQLite keeps it across restarts",
        "The hash chain keeps an override visible: agent said X, human chose Y"
      ]
    }
  ]
