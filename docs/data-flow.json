    "title": "hr-timeoff-agent \u2014 data flow",
    "output": "data-flow.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "decision-data",
        "label": "Decision data",
        "focus": [
          "request",
          "rules",
          "coord",
          "gate",
          "recorder",
          "ledger"
        ],
        "note": "Numbers are the steps of one request and match the sequence diagrams. Step 6 is the pause at the gate."
      },
      {
        "id": "tools",
        "label": "Tool calls",
        "focus": [
          "spec",
          "mcp",
          "qdrant",
          "tenant"
        ],
        "note": "Specialists reach data only through MCP; tenant and audience are fixed server-side."
      },
      {
        "id": "model-boundary",
        "label": "Model boundary",
        "focus": [
          "spec",
          "coord",
          "gate"
        ],
        "note": "Models read findings and tool results and return advice; none writes a decision."
      }
    ],
    "viewBox": [
      1080,
      540
    ]
  },
  "stages": [
    {
      "label": "Inputs"
    },
    {
      "label": "Deterministic"
    },
    {
      "label": "Agents"
    },
    {
      "label": "Human"
    },
    {
      "label": "Record"
    }
  ],
  "nodes": [
