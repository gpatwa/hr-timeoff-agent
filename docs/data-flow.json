  "cards": [
    {
      "dot": "emerald",
      "title": "What moves",
      "items": [
        "Request, Findings, tool results, reports,",
        "then Recommendation, Decision, Evidence",
        "Every tool call also lands in the ledger"
      ]
    },
    {
      "dot": "cyan",
      "title": "Shown: multi-agent mode",
      "items": [
        "Single mode drops MCP and the specialists:",
        "retrieval runs in the graph, then one call",
        "writes the Recommendation; the rest is identical"
      ]
    },
    {
      "dot": "rose",
      "title": "Human boundary",
      "items": [
        "Only the employee's manager can decide",
        "Checked at the gate and again in the recorder",
        "A wrong approver is refused; the request waits"
      ]
    }
